using System;
using System.Linq;
using cAlgo.API;
using cAlgo.API.Internals;

namespace cAlgo.Robots
{
    [Robot(TimeZone = TimeZones.UTC, AccessRights = AccessRights.None)]
    public class Sequential_Combined_MTF_Bot : Robot
    {
        // === RISK MANAGEMENT PARAMETER ===
        [Parameter("Risk per Trade (%)", Group = "Risk Management", DefaultValue = 1.0, MinValue = 0.1)]
        public double RiskPerTradePercent { get; set; }

        [Parameter("Reward Ratio (TP)", Group = "Risk Management", DefaultValue = 2.0)]
        public double RewardRatio { get; set; }

        // === DAILY PARAMS (CODE 1) ===
        [Parameter("Daily Lookback (Tage)", Group = "Daily Settings", DefaultValue = 20, MinValue = 1)]
        public int DailyLookback { get; set; }

        [Parameter("Max Abstand Swing zu FVG (Pips)", Group = "Daily Settings", DefaultValue = 50.0, MinValue = 1.0)]
        public double MaxDistancePips { get; set; }

        [Parameter("Daily Swing Low Lookback (SL)", Group = "Daily Settings", DefaultValue = 5, MinValue = 1)]
        public int DailySwingLookback { get; set; }

        // === H4 PARAMS (CODE 2) ===
        [Parameter("H4 Lookback (Overlap)", Group = "Logic H4", DefaultValue = 15, MinValue = 1)]
        public int H4Lookback { get; set; }

        [Parameter("Swing Lookback (SL)", Group = "Logic H4", DefaultValue = 5, MinValue = 1)]
        public int SwingLookback { get; set; }

        private Bars _dailyBars;
        private int _lastH4FvgBar = -1;
        private bool _firstPositionExecuted = false;

        protected override void OnStart()
        {
            // Zweites Timeframe (Daily) nativ laden
            _dailyBars = MarketData.GetBars(TimeFrame.Daily);
        }

        protected override void OnBar()
        {
            // Bot MUSS zwingend auf H4 gestartet werden
            if (TimeFrame != TimeFrame.Hour4)
            {
                Print("⚠️ Bitte starte den Bot ZWINGEND auf dem H4 Timeframe!");
                return;
            }

            // Warten bis genügend Kerzen vorhanden sind
            int h = Bars.Count - 1;
            if (h < 30 || _dailyBars.Count < 30) return;

            // STATUS-UPDATE: Prüfen, ob bereits mindestens ein Trade ausgeführt wurde
            if (!_firstPositionExecuted)
            {
                _firstPositionExecuted = HasExecutedInitialTrade();
            }

            // -------------------------------------------------------------------
            // PHASE 1: Erst-Einstieg ausführen (CODE 1 LOGIK)
            // Läuft so lange, bis die erste Position / Order platziert wurde
            // -------------------------------------------------------------------
            if (!_firstPositionExecuted)
            {
                if (IsDailySetupActive(out double dailySwingHighPrice))
                {
                    ExecuteEntryCode1(dailySwingHighPrice);
                }
                return; // Nach Phase 1 auf die nächste Kerze warten
            }

            // -------------------------------------------------------------------
            // PHASE 2: Skalierung / H4-Strukturbruch ausführen (CODE 2 LOGIK)
            // Wird erst aktiv, nachdem Phase 1 erfolgreich war!
            // -------------------------------------------------------------------
            ExecuteCode2(h);
        }

        // ===================================================================
        // ABGELEITETE METHODEN AUS CODE 1
        // ===================================================================

        private bool IsDailySetupActive(out double dailySwingHigh)
        {
            dailySwingHigh = -1;

            int d = _dailyBars.Count - 1;

            double gapBottom = _dailyBars.HighPrices[d - 3];
            double gapTop = _dailyBars.LowPrices[d - 1];

            if (gapBottom < gapTop)
            {
                for (int j = d - 5; j >= d - 5 - DailyLookback && j >= 2; j--)
                {
                    if (_dailyBars.HighPrices[j] > _dailyBars.HighPrices[j - 1] &&
                        _dailyBars.HighPrices[j] > _dailyBars.HighPrices[j + 1])
                    {
                        double candidateSwing = _dailyBars.HighPrices[j];
                        double maxAllowedDistance = MaxDistancePips * Symbol.PipSize;

                        if (candidateSwing < gapBottom && candidateSwing >= (gapBottom - maxAllowedDistance))
                        {
                            dailySwingHigh = candidateSwing;
                            return true;
                        }
                    }
                }
            }

            return false;
        }

        private void ExecuteEntryCode1(double targetEntryPrice)
        {
            if (Positions.Any(p => p.Label == "MTF_Trade" && p.SymbolName == SymbolName) ||
                PendingOrders.Any(o => o.Label == "MTF_Trade" && o.SymbolName == SymbolName))
                return;

            int h = Bars.Count - 1;
            double entryPrice = targetEntryPrice;
            double slPrice = GetDailySwingLow();

            if (slPrice >= entryPrice || slPrice <= 0) return;

            double slPips = (entryPrice - slPrice) / Symbol.PipSize;
            double tpPips = slPips * RewardRatio;

            double riskAmount = Account.Equity * (RiskPerTradePercent / 100.0);
            double riskPerVolumeUnit = slPips * Symbol.PipValue;

            if (riskPerVolumeUnit > 0)
            {
                double rawVolume = riskAmount / riskPerVolumeUnit;
                double volume = Symbol.NormalizeVolumeInUnits(rawVolume);

                if (volume >= Symbol.VolumeInUnitsMin)
                {
                    PlaceLimitOrder(TradeType.Buy, SymbolName, volume, entryPrice, "MTF_Trade", slPips, tpPips);

                    Print("🚀 [CODE 1] Erst-Position platziert | Entry: {0} | SL: {1} | TP: {2}",
                        entryPrice, slPrice, entryPrice + (tpPips * Symbol.PipSize));

                    Chart.DrawHorizontalLine("Entry_" + h, entryPrice, Color.Gold, 2);
                    Chart.DrawHorizontalLine("SL_" + h, slPrice, Color.Red, 1, LineStyle.Lines);
                    Chart.DrawHorizontalLine("TP_" + h, entryPrice + (tpPips * Symbol.PipSize), Color.Green, 1, LineStyle.Lines);

                    _firstPositionExecuted = true;
                }
            }
        }

        private double GetDailySwingLow()
        {
            int d = _dailyBars.Count - 1;

            for (int j = d - 2; j >= d - 20; j--)
            {
                if (j - DailySwingLookback < 0) break;

                double candidateLow = _dailyBars.LowPrices[j];
                bool isSwing = true;

                for (int k = 1; k <= DailySwingLookback; k++)
                {
                    if (candidateLow > _dailyBars.LowPrices[j - k] || candidateLow > _dailyBars.LowPrices[j + k])
                    {
                        isSwing = false;
                        break;
                    }
                }

                if (isSwing)
                {
                    return candidateLow - (5 * Symbol.PipSize);
                }
            }

            double minLow = double.MaxValue;
            for (int i = d - 1; i >= d - 10; i--)
            {
                if (_dailyBars.LowPrices[i] < minLow)
                    minLow = _dailyBars.LowPrices[i];
            }

            return minLow - (5 * Symbol.PipSize);
        }

        // ===================================================================
        // ABGELEITETE METHODEN AUS CODE 2
        // ===================================================================

        private void ExecuteCode2(int h)
        {
            if (_lastH4FvgBar == h) return;

            if (HasActiveOrderOrPosition("H4_FVG_Overlap")) return;

            double h4GapBottom = Bars.HighPrices[h - 3];
            double h4GapTop = Bars.LowPrices[h - 1];

            if (h4GapBottom < h4GapTop)
            {
                double h4SwingHighPrice = -1;
                bool h4SwingFound = false;

                for (int j = h - 5; j >= h - 5 - H4Lookback && j >= 2; j--)
                {
                    if (Bars.HighPrices[j] > Bars.HighPrices[j - 1] &&
                        Bars.HighPrices[j] > Bars.HighPrices[j + 1])
                    {
                        h4SwingHighPrice = Bars.HighPrices[j];
                        h4SwingFound = true;
                        break;
                    }
                }

                if (h4SwingFound && h4GapBottom >= h4SwingHighPrice)
                {
                    double entryPrice = h4SwingHighPrice;
                    double slPrice = GetExactSwingLow(h);

                    if (slPrice >= entryPrice || slPrice <= 0) return;

                    double slPips = (entryPrice - slPrice) / Symbol.PipSize;
                    double riskAmount = Account.Equity * (RiskPerTradePercent / 100.0);
                    double riskPerVolumeUnit = slPips * Symbol.PipValue;

                    if (riskPerVolumeUnit > 0)
                    {
                        double rawVolume = riskAmount / riskPerVolumeUnit;
                        double volume = Symbol.NormalizeVolumeInUnits(rawVolume);

                        if (volume >= Symbol.VolumeInUnitsMin)
                        {
                            PlaceLimitOrder(TradeType.Buy, SymbolName, volume, entryPrice, "H4_FVG_Overlap", slPips, slPips * RewardRatio);

                            _lastH4FvgBar = h;

                            Chart.DrawHorizontalLine("H4_Entry_" + h, entryPrice, Color.Yellow, 2, LineStyle.Solid);
                            Chart.DrawHorizontalLine("H4_SL_" + h, slPrice, Color.Red, 1, LineStyle.Lines);

                            Print("🚀 [CODE 2 / SKALIERUNG] H4 Strukturbruch! Buy Limit platziert bei: {0}, SL: {1}", entryPrice, slPrice);
                        }
                    }
                }
            }
        }

        private bool HasActiveOrderOrPosition(string label)
        {
            bool hasPosition = Positions.Any(p => p.Label == label && p.SymbolName == SymbolName);
            bool hasOrder = PendingOrders.Any(o => o.Label == label && o.SymbolName == SymbolName);
            return hasPosition || hasOrder;
        }

        private double GetExactSwingLow(int fromIndex)
        {
            for (int j = fromIndex - 2; j >= fromIndex - 30; j--)
            {
                if (j - SwingLookback < 0) break;

                double candidateLow = Bars.LowPrices[j];
                bool isSwing = true;

                for (int k = 1; k <= SwingLookback; k++)
                {
                    if (candidateLow > Bars.LowPrices[j - k] || candidateLow > Bars.LowPrices[j + k])
                    {
                        isSwing = false;
                        break;
                    }
                }

                if (isSwing) return candidateLow;
            }

            return Bars.LowPrices[fromIndex - 3];
        }

        // Helper zur Feststellung, ob Code 1 schon einmal ausgeführt wurde
        private bool HasExecutedInitialTrade()
        {
            return History.Any(h => h.Label == "MTF_Trade" && h.SymbolName == SymbolName) ||
                   Positions.Any(p => p.Label == "MTF_Trade" && p.SymbolName == SymbolName) ||
                   PendingOrders.Any(o => o.Label == "MTF_Trade" && o.SymbolName == SymbolName);
        }
    }
}

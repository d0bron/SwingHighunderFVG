using System;
using System.Linq;
using cAlgo.API;
using cAlgo.API.Internals;

namespace cAlgo.Robots
{
    [Robot(TimeZone = TimeZones.UTC, AccessRights = AccessRights.None)]
    public class Native_MTF_DailySL_Bot : Robot
    {
        // === RISK MANAGEMENT PARAMETER ===
        [Parameter("Risk per Trade (%)", Group = "Risk Management", DefaultValue = 1.0, MinValue = 0.1)]
        public double RiskPerTradePercent { get; set; }

        [Parameter("Reward Ratio (TP)", Group = "Risk Management", DefaultValue = 2.0)]
        public double RewardRatio { get; set; }

        // === DAILY PARAMS ===
        [Parameter("Daily Lookback (Tage)", Group = "Daily Settings", DefaultValue = 20, MinValue = 1)]
        public int DailyLookback { get; set; }

        [Parameter("Max Abstand Swing zu FVG (Pips)", Group = "Daily Settings", DefaultValue = 50.0, MinValue = 1.0)]
        public double MaxDistancePips { get; set; }

        [Parameter("Daily Swing Low Lookback (SL)", Group = "Daily Settings", DefaultValue = 5, MinValue = 1)]
        public int DailySwingLookback { get; set; }

        private Bars _dailyBars;

        protected override void OnStart()
        {
            // Zweites Timeframe (Daily) nativ laden – funktioniert perfekt im cTrader-Backtest
            _dailyBars = MarketData.GetBars(TimeFrame.Daily);
        }

        protected override void OnBar()
        {
            // Bot MUSS zwingend auf H4 gestartet werden
            if (TimeFrame != TimeFrame.Hour4)
            {
                Print("⚠️ Bitte starte den Bot ZWINGEND auf dem H4 Timeframe!");
                return;
            }

            // Warten bis genügend Kerzen in beiden Timeframes vorhanden sind
            if (Bars.Count < 30 || _dailyBars.Count < 30) return;

            // SCHRITT 1: Prüfen ob auf Daily ein valides Setup vorliegt
            if (IsDailySetupActive(out double dailySwingHighPrice))
            {
                // SCHRITT 2: Einstieg auf H4 mit Daily Swing High & Daily Swing Low (SL) ausführen
                ExecuteEntry(dailySwingHighPrice);
            }
        }

        /// <summary>
        /// Prüft das übergeordnete Daily-Setup (Fair Value Gap + Swing High unter FVG Unterkante)
        /// </summary>
        private bool IsDailySetupActive(out double dailySwingHigh)
        {
            dailySwingHigh = -1;

            // Abgeschlossene Daily-Kerze
            int d = _dailyBars.Count - 1;

            // Daily FVG Logik (Kerze d-3 High < Kerze d-1 Low)
            double gapBottom = _dailyBars.HighPrices[d - 3];
            double gapTop = _dailyBars.LowPrices[d - 1];

            if (gapBottom < gapTop)
            {
                // Daily Swing High Suchen
                for (int j = d - 5; j >= d - 5 - DailyLookback && j >= 2; j--)
                {
                    if (_dailyBars.HighPrices[j] > _dailyBars.HighPrices[j - 1] &&
                        _dailyBars.HighPrices[j] > _dailyBars.HighPrices[j + 1])
                    {
                        double candidateSwing = _dailyBars.HighPrices[j];
                        double maxAllowedDistance = MaxDistancePips * Symbol.PipSize;

                        // Bedingung: Swing High liegt STRIKT unter FVG Bottom, aber innerhalb von MaxDistancePips
                        if (candidateSwing < gapBottom && candidateSwing >= (gapBottom - maxAllowedDistance))
                        {
                            dailySwingHigh = candidateSwing;
                            return true;
                        }
                    }
                }
            }

            return false;
        }

        /// <summary>
        /// Platziert die Limit-Order exakt auf Höhe des Daily Swing Highs mit SL unter dem Daily Swing Low
        /// </summary>
        private void ExecuteEntry(double targetEntryPrice)
        {
            // Keine Mehrfachtrades zulassen
            if (Positions.Any(p => p.Label == "MTF_Trade" && p.SymbolName == SymbolName) ||
                PendingOrders.Any(o => o.Label == "MTF_Trade" && o.SymbolName == SymbolName))
                return;

            int h = Bars.Count - 1;

            // Einstieg exakt am Daily Swing High
            double entryPrice = targetEntryPrice;
            
            // Stop-Loss: Ermittlung aus dem DAILY Chart (unter das Daily Swing Low)
            double slPrice = GetDailySwingLow();
            
            // Validierung: SL muss logischerweise unter dem Entry liegen
            if (slPrice >= entryPrice || slPrice <= 0) return;

            // Berechnung des Abstands in Pips
            double slPips = (entryPrice - slPrice) / Symbol.PipSize;

            // Take Profit exakt auf 1:2 CRV (RewardRatio = 2.0)
            double tpPips = slPips * RewardRatio;

            // Dynamische Positionsgrößenberechnung basierend auf % Risiko
            double riskAmount = Account.Equity * (RiskPerTradePercent / 100.0);
            double riskPerVolumeUnit = slPips * Symbol.PipValue;

            if (riskPerVolumeUnit > 0)
            {
                double rawVolume = riskAmount / riskPerVolumeUnit;
                double volume = Symbol.NormalizeVolumeInUnits(rawVolume);

                if (volume >= Symbol.VolumeInUnitsMin)
                {
                    // Limit Order mit Daily-SL und 1:2 TP platziert
                    PlaceLimitOrder(TradeType.Buy, SymbolName, volume, entryPrice, "MTF_Trade", slPips, tpPips);
                    
                    Print("🚀 Limit Order platziert | Entry (Daily Swing High): {0} | SL (Daily Swing Low): {1} | TP (1:2): {2}", 
                        entryPrice, slPrice, entryPrice + (tpPips * Symbol.PipSize));
                    
                    // Visuelle Linien im Chart einzeichnen
                    Chart.DrawHorizontalLine("Entry_" + h, entryPrice, Color.Gold, 2);
                    Chart.DrawHorizontalLine("SL_" + h, slPrice, Color.Red, 1, LineStyle.Lines);
                    Chart.DrawHorizontalLine("TP_" + h, entryPrice + (tpPips * Symbol.PipSize), Color.Green, 1, LineStyle.Lines);
                }
            }
        }

        /// <summary>
        /// Ermittelt das tiefste Daily Swing Low aus dem Tageschart als strukturellen Stop Loss
        /// </summary>
        private double GetDailySwingLow()
        {
            int d = _dailyBars.Count - 1;

            // Durchsuche die letzten Daily-Kerzen nach einem sauberen Swing Low
            for (int j = d - 2; j >= d - 20; j--)
            {
                if (j - DailySwingLookback < 0) break;

                double candidateLow = _dailyBars.LowPrices[j];
                bool isSwing = true;

                for (int k = 1; k <= DailySwingLookback; k++)
                {
                    if (candidateLow > _dailyBars.LowPrices[j - k] || candidateLow > _dailyBars.LowPrices[j + k])
                    {
                        isSwing = false;
                        break;
                    }
                }

                if (isSwing)
                {
                    // 5 Pips Sicherheits-Puffer unter das Daily Tief legen
                    return candidateLow - (5 * Symbol.PipSize);
                }
            }

            // Fallback: Tiefste Daily-Kerze der letzten 10 Tage nehmen
            double minLow = double.MaxValue;
            for (int i = d - 1; i >= d - 10; i--)
            {
                if (_dailyBars.LowPrices[i] < minLow)
                    minLow = _dailyBars.LowPrices[i];
            }

            return minLow - (5 * Symbol.PipSize);
        }
    }
}
